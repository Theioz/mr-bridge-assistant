# Mr. Bridge — template for the repo-root env file, which the host Python scripts read
# (scripts/_supabase.py). The same variable names go in the two other places that are NOT
# this file: the app container's env file and the MCP server's ~/.mrb-secrets/env.
# Which process reads which file: docs/OPERATIONS.md ("Env files and who reads them").
# Real values live in a password vault, never in this repo.
#
# Single-user and self-hosted. The Anthropic API is optional and used only for food
# identification (see below).

# ── Supabase (self-hosted) ───────────────────────────────────────────────────
# The browser and the server reach Supabase on DIFFERENT urls. This is deliberate
# and must not be "simplified":
#   SUPABASE_URL              read by the Python scripts and the MCP server only. On a
#                             laptop: the private-network hostname below. On the server
#                             itself the cron entries override it inline with
#                             http://localhost:8000.
#   NEXT_PUBLIC_SUPABASE_URL  what the BROWSER uses (see web/.env.local.example).
#   SUPABASE_INTERNAL_URL     set ONLY inside the app container. The app's server has no
#                             route to the private-network hostname, which fails there
#                             with "fetch failed".
SUPABASE_URL=https://supabase.<your-domain>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_INTERNAL_URL=http://supabase-gateway:8000   # app container only

# The app image also needs NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY and
# NEXT_PUBLIC_APP_URL as BUILD args (web/Dockerfile) — they are inlined into the client
# bundle at build time. See web/.env.local.example.

# These are LEGACY JWT keys, signed with the Supabase stack's JWT_SECRET.
# Supabase Cloud's newer sb_publishable_/sb_secret_ keys are a Cloud-only auth
# system and do NOT work against self-hosted GoTrue/PostgREST.

# ── The one you cannot lose ──────────────────────────────────────────────────
# pgcrypto key for user_integrations.refresh_token_encrypted — the Google,
# Google Health and Oura REFRESH TOKENS. Lose it and every integration must be
# re-authorised by hand. Always prove it decrypts a real row before trusting a restore.
ENCRYPTION_KEY=<32-byte-hex-key>

# ── Identity ─────────────────────────────────────────────────────────────────
# A literal auth.users UUID. Every table FKs to it and the cron resolves the owner
# through it, so it must match the database exactly.
OWNER_USER_ID=<owner-auth-uuid>

# ── Google OAuth (Calendar) ──────────────────────────────────────────────────
# Providers redirect the BROWSER (which is on the private network), so they never need
# to reach the URL themselves — which is why a private-network host works for OAuth.
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://mr-bridge.<your-domain>/api/auth/google/callback

# ── Fitness integrations ─────────────────────────────────────────────────────
# Google Health (#607) reuses GOOGLE_CLIENT_ID/SECRET above but is consented
# SEPARATELY: this token feeds an unattended cron, and an interactive Calendar
# re-consent must not be able to invalidate it. (The original reason was a Gmail
# scope on the Calendar grant; #693 removed that scope.) Register this callback on
# the same OAuth client as GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_HEALTH_OAUTH_REDIRECT_URI=https://mr-bridge.<your-domain>/api/auth/google-health/callback

# Oura — OAuth2 (#732; Oura deprecated Personal Access Tokens). Register an app at
# cloud.ouraring.com/oauth/applications with this callback. Oura rotates the refresh
# token on every exchange; the sync persists the new one.
OURA_CLIENT_ID=<oura-client-id>
OURA_CLIENT_SECRET=<oura-client-secret>
OURA_OAUTH_REDIRECT_URI=https://mr-bridge.<your-domain>/api/auth/oura/callback
# OURA_SCOPES=daily spo2   # optional override; default is "daily spo2"

# ── Nutrition: USDA FoodData Central ─────────────────────────────────────────
# Macros come from MEASURED DATA, not a language model's memory. Free key:
#   https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=<fdc-api-key>

# ── Food-identification model ────────────────────────────────────────────────
# With ANTHROPIC_API_KEY set, Claude identifies foods, reads labels, parses meal text and picks
# USDA matches. Without it, the local Ollama model below does. LLM_PROVIDER=ollama|anthropic
# forces one. Either way the model NEVER supplies grams or calories — USDA does.
# ANTHROPIC_API_KEY=<anthropic-api-key>
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_PROVIDER=

# ── Local model (Ollama): the fallback ───────────────────────────────────────
# Identifies foods and reads quantity+unit. NEVER asked for grams or calories —
# it was measured ~2x off on portion weight (a large egg at 105g; real ~50g), so
# USDA does the arithmetic.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_VISION_MODEL=   # optional: separate model for photo identification; defaults to OLLAMA_MODEL

# ── Stocks / sports ──────────────────────────────────────────────────────────
# ESPN needs no key. TheSportsDB was removed in #368 — there is no SPORTSDB key.
POLYGON_API_KEY=<polygon-api-key>

# ── Media metadata (Library / Backlog) ───────────────────────────────────────
TMDB_API_KEY=<tmdb-api-key>
IGDB_CLIENT_ID=<igdb-client-id>
IGDB_CLIENT_SECRET=<igdb-client-secret>
GOOGLE_BOOKS_API_KEY=<google-books-api-key>

# ── Plex watch sync (#691) ───────────────────────────────────────────────────
# Optional. Unset = the sync is skipped. The URL must be one the app's server can
# route to (a LAN address, not a private-network hostname). A Plex server with
# "Secure connections: Required" refuses plain HTTP from other hosts; use its
# plex.direct name, as below. Token: PlexOnlineToken in the server's Preferences.xml.
# PLEX_ACCOUNT_ID defaults to 1 (the server owner).
PLEX_URL=https://<lan-ip-with-dashes>.<server-hash>.plex.direct:32400
PLEX_TOKEN=<plex-token>
# PLEX_ACCOUNT_ID=1

# ── Timezone ─────────────────────────────────────────────────────────────────
USER_TIMEZONE=America/Los_Angeles

# ── Cron ─────────────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* and /api/internal/*. The callers are the host's
# crontab, scripts/run-syncs.py and scripts/weekly_plan.py.
CRON_SECRET=<random-string>

# ── Notifications (ntfy.sh) ──────────────────────────────────────────────────
# MIND THE SPELLING. An old deployment had this as NFTY_TOPIC while the code reads
# NTFY_TOPIC, so pushes silently failed for months. scripts/_push.py now exits
# non-zero when the topic is missing, but do not reintroduce the typo.
NTFY_TOPIC=<your-ntfy-topic>

# Where a tapped notification opens. A private-network hostname: reachable from a
# phone or laptop on that network, but NOT from the app's own server.
APP_URL=https://mr-bridge.<your-domain>

# Origin for HOST-LOCAL server-to-server calls: scripts on the server calling the app's
# own API (scripts/run-syncs.py, scripts/weekly_plan.py). Must NOT be APP_URL: that call
# fails at connect, which reads as "the app is down".
INTERNAL_APP_URL=http://localhost:3000

# Share links go to people OUTSIDE the private network, so they must resolve on the
# PUBLIC host. Using APP_URL here would hand recipients an unreachable link.
SHARE_BASE_URL=https://share.<your-domain>

# ── REMOVED (do not reintroduce) ─────────────────────────────────────────────
# (the in-app chat is gone: chat is the MCP server, web/mcp/, on the Claude
#  subscription. ANTHROPIC_API_KEY is back, but ONLY for the nutrition model above.)
# GROQ_API_KEY          was only the demo account's chat path; the demo is gone.
# PICOVOICE_ACCESS_KEY  voice/ was deleted.
# OURA_ACCESS_TOKEN     replaced by Oura OAuth2 (#732).
