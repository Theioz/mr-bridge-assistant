# Mr. Bridge — web/.env.local, for local `npm run dev` (http://localhost:3000).
# Single-user and self-hosted (#476): the deployed app is a Docker image whose env is
# the root .env (see ../.env.example, which explains each variable in more depth).
# No Vercel, no Anthropic API key.

# ── Supabase (self-hosted) ────────────────────────────────────────────────────
# NEXT_PUBLIC_ vars are exposed to the browser (anon key only — safe) and are inlined
# into the client bundle at BUILD time.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.<your-domain>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Service role key is server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Optional: server-side Supabase URL when the server cannot reach the public one.
# Unset = falls back to NEXT_PUBLIC_SUPABASE_URL (normal for local dev).
# SUPABASE_INTERNAL_URL=

# pgcrypto key for the encrypted OAuth refresh tokens in user_integrations.
# Must be the same key the database's tokens were encrypted with.
ENCRYPTION_KEY=<32-byte-hex-key>

# ── Owner user ID ─────────────────────────────────────────────────────────────
# Your Supabase auth UID — the cron sync writes to this user.
# Run: python3 scripts/print_owner_id.py to get your UID.
OWNER_USER_ID=<your-supabase-auth-uid>

# ── App URLs ──────────────────────────────────────────────────────────────────
# OAuth callbacks redirect back to NEXT_PUBLIC_APP_URL; APP_URL is the login callback
# origin and the push-notification click target. SHARE_BASE_URL is where public share
# links point (falls back to APP_URL).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SHARE_BASE_URL=

# ── Google OAuth (Calendar) ───────────────────────────────────────────────────
# Web-application OAuth client; register both callbacks below as redirect URIs.
# Connect via Settings → Integrations; tokens are stored encrypted in user_integrations.
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Fitness integrations ──────────────────────────────────────────────────────
# Google Health (#607, replaced Fitbit + Google Fit) reuses the Google client above
# but is consented separately.
GOOGLE_HEALTH_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google-health/callback
# Oura — OAuth2 (#732). See README, Step 5.
OURA_CLIENT_ID=<your-oura-client-id>
OURA_CLIENT_SECRET=<your-oura-client-secret>
OURA_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oura/callback
# OURA_SCOPES=daily spo2   # optional override

# ── Nutrition ─────────────────────────────────────────────────────────────────
# USDA FoodData Central supplies every macro: https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=<your-fdc-api-key>
# Local model (Ollama) — identifies foods and reads quantities, never grams/calories.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_VISION_MODEL=   # optional; defaults to OLLAMA_MODEL

# ── User preferences ──────────────────────────────────────────────────────────
# IANA timezone string — used for calendar event creation and date calculations
USER_TIMEZONE=America/Los_Angeles

# ── Cron authentication ───────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (called by the host crontab and scripts/run-syncs.py).
# Generate with: openssl rand -hex 32
CRON_SECRET=<generate-with-openssl-rand-hex-32>

# ── Notifications ─────────────────────────────────────────────────────────────
# ntfy topic for server-side pushes (the weekly recipe audit). Spelled NTFY, not NFTY.
NTFY_TOPIC=<your-ntfy-topic>

# ── Stock watchlist (optional) ────────────────────────────────────────────────
# Polygon.io API key — free tier supports end-of-day data.
# Used by the watchlist widget and the `get_stock_quote` MCP tool.
POLYGON_API_KEY=<your-polygon-api-key>

# ── Sports widget (ESPN, no key required) ─────────────────────────────────────
# TheSportsDB support has been removed (#368).

# ── Library — metadata APIs (server-side only, never NEXT_PUBLIC_) ────────────
# TMDB (movies + shows): themoviedb.org → Settings → API → Create API key
TMDB_API_KEY=<your-tmdb-api-key>

# IGDB (games): requires a Twitch Developer account
# dev.twitch.tv → Your Console → Applications → Register Your Application
# Set Category=Website, OAuth Redirect URL=http://localhost:3000 (any valid URL)
# Copy Client ID and generate a New Secret.
IGDB_CLIENT_ID=<your-twitch-client-id>
IGDB_CLIENT_SECRET=<your-twitch-client-secret>

# Google Books (optional books fallback when OpenLibrary lacks cover images)
# console.cloud.google.com → APIs & Services → Library → Books API → Enable
# → Credentials → Create API key
# If unset, OpenLibrary is used exclusively (no key required) — most books are covered.
GOOGLE_BOOKS_API_KEY=<your-google-books-api-key>

# Plex watch sync (optional): marks watched movies/shows in the Library. Unset = skipped.
# PLEX_URL=http://<plex-host>:32400
# PLEX_TOKEN=<plex-token>
# PLEX_ACCOUNT_ID=1   # defaults to 1, the server owner
