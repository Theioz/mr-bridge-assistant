# To re-render:
# d2 --layout=elk --theme=200 docs/architecture.d2 docs/architecture.svg && sed -i '' 's/data-d2-version="[^"]*" preserveAspectRatio="[^"]*" viewBox="/width="100%" viewBox="/' docs/architecture.svg
# d2 --layout=elk --theme=200 --scale=2 docs/architecture.d2 docs/architecture.png

direction: right

data_sources: "Data Sources\nOura · Google Health · Plex"

sync: "Sync Layer\nTypeScript modules (web/src/lib/sync)\nnode crontab 14:00 UTC · scripts/run-syncs.py"

supabase: "Self-hosted Supabase\nPostgres · GoTrue · PostgREST\nRLS on every public table"

nextjs: "Next.js standalone · Docker (compute-core)\nApp Router · route handlers"

external: "External APIs\nGoogle Calendar · USDA FoodData\nOpen-Meteo · Polygon · ESPN · TMDB · ntfy.sh"

ollama: "Ollama (local, compute-core)\nqwen2.5vl:7b · food identification"

user: "Browser / Mobile"

mcp: "MCP server (web/mcp)\nstdio · lib/tools"

claude: "Claude Code"

data_sources -> sync
sync -> supabase: write / upsert
supabase -> nextjs: query / SSR
nextjs -> supabase: write
nextjs -> user
external -> nextjs: OAuth · macros · media · EOD
ollama -> nextjs: vision (qty + unit only)
mcp -> supabase: service role
claude -> mcp: tool calls

data_sources.style.stroke: "#10B981"
data_sources.style.font-color: "#10B981"

sync.style.stroke: "#6366F1"

supabase.style.fill: "#422006"
supabase.style.stroke: "#F59E0B"
supabase.style.font-color: "#FDE68A"
supabase.style.bold: true

nextjs.style.stroke: "#38BDF8"

external.style.stroke: "#475569"
external.style.font-color: "#94A3B8"

ollama.style.stroke: "#A78BFA"
ollama.style.font-color: "#C4B5FD"

user.style.fill: "#F8FAFC"
user.style.stroke: "#CBD5E1"
user.style.font-color: "#1E293B"

mcp.style.stroke: "#6366F1"

claude.style.stroke: "#CBD5E1"
